# SupplyProof Environment Configuration Template
# Team: HashGuard | Project: SupplyProof
# Duplicate this file to .env and configure your local or testnet credentials.

# Network & RPC
LOCAL_RPC_URL="http://127.0.0.1:8545"
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# Smart Contract
VITE_SUPPLYPROOF_CONTRACT_ADDRESS="0x5FC8d32690cc91D4c39d9d3abcBD16989F875707"
VITE_CHAIN_ID="31337"

# Public Verification & QR Base URL (Optional - defaults to LAN IP or Vercel origin)
# VITE_APP_URL="https://supplyproof.vercel.app"

# Backend & Database
PORT=5000
MONGODB_URI="mongodb://localhost:27017/supplyproof"
JWT_SECRET="replace_with_a_secure_jwt_secret_token"

# IPFS / Decentralized Storage
PINATA_API_KEY="your_pinata_api_key"
PINATA_API_SECRET="your_pinata_api_secret"
